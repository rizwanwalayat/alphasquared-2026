# MongoDB Atlas connection. Set these in Netlify → Site settings → Environment
# variables. Never commit the real values: this file documents the names only.

# SRV connection string for the Atlas cluster, with a user scoped to this
# database alone (readWrite on the site database, nothing else).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Database the site writes to.
MONGODB_DB=alphasquared

# Random 32+ character string. Visitor IPs are hashed with it before storage so
# a leaked dump cannot be reversed into addresses, while still allowing rate
# limiting and duplicate detection.
IP_HASH_SALT=change-me-to-a-long-random-string

# Origin allowed to call the functions. Leave unset in local dev.
SITE_ORIGIN=https://alphasquared.ca
